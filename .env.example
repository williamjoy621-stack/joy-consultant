# GEMINI_API_KEY: Required for Gemini AI API calls (AI Real Estate Chatbot, AI Property Recommender, AI Admin Business Assistant).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

#VITE_GOOGLE_MAPS_API_KEY: Auto-provisioned or custom Google Maps Platform API key for interactive property & office maps.
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# PAYSTACK_SECRET_KEY: Optional secret key for live Paystack server-side transaction & webhook verification.
PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key"
VITE_PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key"
